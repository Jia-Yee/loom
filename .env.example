# AutoML LLM 配置
# 复制为 .env 并填写实际值

# LLM 提供方: deepseek | ollama
# 不设则跳过 LLM 分析，训练评估正常执行
AUTOML_LLM_PROVIDER=

# DeepSeek: 填 API Key；Ollama: 填任意占位符
AUTOML_LLM_API_KEY=

# 覆盖默认端点（可选）
# DeepSeek 默认: https://api.deepseek.com
# Ollama 默认: http://localhost:11434/v1
AUTOML_LLM_BASE_URL=

# 模型名（可选，按 provider 取默认）
# DeepSeek 默认: deepseek-chat
# Ollama 默认: qwen2.5:7b
AUTOML_LLM_MODEL=

# 超时秒数（可选，默认 120，本地 Ollama 建议至少 120）
AUTOML_LLM_TIMEOUT=120
